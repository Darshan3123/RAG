# ==============================================================================
# .env.production — GeMBridge Production Environment Configuration
# Specifically tuned for Dokploy & Hostinger KVM 4 VPS (srv1701681)
# Copy this file to .env on the server and update with your real secrets.
# ==============================================================================

# ── 1. DOKPLOY & TRAEFIK DOMAIN CONFIGURATION ─────────────────────────────────
# Set to 'true' when routing through Dokploy's Traefik reverse proxy
ENABLE_TRAEFIK=true
TRAEFIK_CERT_RESOLVER=letsencrypt

# Domain names for public routing (DNS A records must point to your VPS IP)
GATEWAY_DOMAIN=api.yourgembridge.com
FLOWER_DOMAIN=flower.yourgembridge.com

# Direct ports (used if accessing directly or without Traefik)
GATEWAY_PORT=8000
FLOWER_PORT=5555

# Flower Dashboard Basic Auth (username:password)
FLOWER_BASIC_AUTH=admin:StrongProductionPassword2026!

# ── 2. SHARED POSTGRESQL & PGVECTOR DATABASE ──────────────────────────────────
# Connects to your existing shared PostgreSQL instance running on the VPS.
# If PostgreSQL is running on the host OS: use host.docker.internal or host private IP
# If PostgreSQL is running in another Dokploy container: use the container name / network
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=gem-bridge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_production_postgres_password_here
DATABASE_URL=postgresql://postgres:your_production_postgres_password_here@host.docker.internal:5432/gem-bridge

# ── 3. REDIS BROKER (CONTAINERIZED IN STACK) ──────────────────────────────────
# Connects to the Redis 7 Alpine service defined in docker-compose.prod.yml
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── 4. SHARED MINIO S3 OBJECT STORAGE ─────────────────────────────────────────
# Connects to your existing shared MinIO instance running on the VPS.
# Note: Use host.docker.internal:9000 if MinIO is on the host, or its shared URL.
MINIO_ENDPOINT=host.docker.internal:9000
MINIO_ACCESS_KEY=your_production_minio_access_key
MINIO_SECRET_KEY=your_production_minio_secret_key
MINIO_BUCKET=gem-tenders
MINIO_SECURE=false

# ── 5. AI INFERENCE & OCR API CREDENTIALS ─────────────────────────────────────
# Mistral Cloud OCR (used for selective annexure parsing)
OCR_PROVIDER=mistral
MISTRAL_API_KEY=your_mistral_api_key_here
ENABLE_PDF_ATC_SPLIT=true

# Google Gemini (Primary compliance & RAG synthesis engine)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
ENABLE_ATC_ANALYSIS=true
ATC_LLM_PROVIDER=gemini

# Optional OpenAI Fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# HuggingFace Token (Optional, for downloading weights if needed)
HF_TOKEN=

# ── 6. RAG & VECTOR SEARCH CONFIGURATION ──────────────────────────────────────
# Embeddings run fully offline in container using local sentence-transformers
RAG_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5
RAG_LLM_PROVIDER=gemini

# ── 7. CELERY WORKER SCHEDULER & LIMITS ───────────────────────────────────────
MAX_CONCURRENT_WORKERS=6
TARGET_PER_TYPE=5
MAX_RETRIES_PER_BID=3
RETRY_DELAY_SECONDS=10

# ── 8. ANTI-BOT & PORTAL SCRAPER TIMINGS ──────────────────────────────────────
GEM_BASE_URL=https://bidplus.gem.gov.in
MAX_EMPTY_PAGES=5
PAGE_LOAD_WAIT_MIN=4
PAGE_LOAD_WAIT_MAX=8
BETWEEN_CARDS_WAIT_MIN=1
BETWEEN_CARDS_WAIT_MAX=3
