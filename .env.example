# =============================================================
# .env  —  GeM Scraper Configuration
# Copy this file and rename to .env, then fill in your values.
# NEVER commit this file to git.
# =============================================================

# ---------------------------------------------------------
# SCHEDULER
# ---------------------------------------------------------
SCRAPE_INTERVAL_MINUTES=60
MAX_RETRIES_PER_BID=3
RETRY_DELAY_SECONDS=10

# ---------------------------------------------------------
# ANTI-BOT DELAYS  (seconds, min and max of random range)
# ---------------------------------------------------------
PAGE_LOAD_WAIT_MIN=4
PAGE_LOAD_WAIT_MAX=8

BETWEEN_CARDS_WAIT_MIN=1
BETWEEN_CARDS_WAIT_MAX=3

BETWEEN_PAGES_WAIT_MIN=3
BETWEEN_PAGES_WAIT_MAX=6

FILTER_CLICK_WAIT_MIN=3
FILTER_CLICK_WAIT_MAX=6

PDF_DOWNLOAD_WAIT_MIN=2
PDF_DOWNLOAD_WAIT_MAX=4

# ---------------------------------------------------------
# SCRAPER TARGETS
# ---------------------------------------------------------
GEM_BASE_URL=https://bidplus.gem.gov.in
TARGET_PER_TYPE=1
MAX_EMPTY_PAGES=5

# ---------------------------------------------------------
# PATHS  (relative to project root — override if needed)
# ---------------------------------------------------------
DOWNLOAD_DIR=downloads
LOG_DIR=logs
DB_PATH=storage/gem_bids.db
JSON_OUT_PATH=storage/gem_bids.json
# ---------------------------------------------------------
# RAG — EMBEDDINGS
# Recommended for English bid text:
#   BAAI/bge-base-en-v1.5    (best quality)
#   BAAI/bge-small-en-v1.5   (faster, smaller)
#   all-MiniLM-L6-v2         (legacy / lowest quality)
# ---------------------------------------------------------
RAG_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
CHROMA_DIR=storage/chroma_db
CHROMA_COLLECTION=gem_bids
RAG_TOP_K=5
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100

# ---------------------------------------------------------
# RAG — HYBRID RETRIEVAL
# Fetch K chunks per leg (dense + BM25), then fuse via RRF.
# ---------------------------------------------------------
RAG_FETCH_K=40
RAG_DENSE_WEIGHT=0.6
RAG_BM25_WEIGHT=0.4

# ---------------------------------------------------------
# RAG — CROSS-ENCODER RERANKER
# Single biggest score booster. Set RAG_USE_RERANKER=false to
# disable on low-memory machines.
# ---------------------------------------------------------
RAG_USE_RERANKER=true
RAG_RERANKER_MODEL=BAAI/bge-reranker-base

# ---------------------------------------------------------
# LLM CREDENTIALS & DEFAULTS (Shared across RAG & ATC)
# ---------------------------------------------------------
# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama (Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ---------------------------------------------------------
# RAG — LLM PROVIDER
# Options: ollama | openai | gemini | (leave empty for retrieval-only)
# ---------------------------------------------------------
RAG_LLM_PROVIDER=ollama

# ---------------------------------------------------------
# ATC EXTRACTOR — LLM CONFIG
# Options: gemini | openai
# ---------------------------------------------------------
ENABLE_ATC_ANALYSIS=true

HF_TOKEN=your_huggingface_token_here

# ---------------------------------------------------------
# POSTGRESQL & PGVECTOR
# ---------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gem-bridge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gem-bridge

# ---------------------------------------------------------
# REDIS & CELERY BROKER
# ---------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---------------------------------------------------------
# MINIO S3 OBJECT STORAGE
# ---------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=gem-tenders
MINIO_SECURE=false

# ---------------------------------------------------------
# WORKER CONCURRENCY & LIMITS
# ---------------------------------------------------------
MAX_CONCURRENT_WORKERS=6

# ---------------------------------------------------------
# FASTAPI GATEWAY & INTERNAL AUTHENTICATION (Phase 1)
# ---------------------------------------------------------
GATEWAY_INTERNAL_KEY=gem_internal_secret_key_prod_v4_development_2026
GATEWAY_INTERNAL_KEY_PREVIOUS=
GATEWAY_ENABLE_ADMIN_ROUTES=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
MINIO_PUBLIC_ENDPOINT=localhost:9000