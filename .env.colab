# =============================================================
# .env.colab — Google Colab Configuration Template
# Copy this to .env when running on Colab, OR set these as
# os.environ values in Cell 4 of colab_setup.ipynb
# =============================================================

# ---------------------------------------------------------
# PATHS — point to Google Drive for persistence
# Replace /content/drive/MyDrive/gem_scraper_data with your
# actual Google Drive folder path.
# ---------------------------------------------------------
DB_PATH=storage/gem_bids.db
JSON_OUT_PATH=storage/gem_bids.json
CHROMA_DIR=storage/chroma_db
LOG_DIR=logs
DOWNLOAD_DIR=downloads
TENDER_DB_PATH=storage/tenders.db
TENDER_JSON_PATH=storage/tenders.json

# ---------------------------------------------------------
# RAG — use larger model since Colab T4 has 15GB VRAM
# ---------------------------------------------------------
RAG_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
CHROMA_COLLECTION=gem_bids
RAG_TOP_K=10
RAG_FETCH_K=100
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100

# Hybrid retrieval
RAG_DENSE_WEIGHT=0.6
RAG_BM25_WEIGHT=0.4

# Reranker — enabled (T4 GPU handles this fast)
RAG_USE_RERANKER=true
RAG_RERANKER_MODEL=BAAI/bge-reranker-base

# Allow HuggingFace model downloads
HF_OFFLINE=false
HF_TOKEN=your_huggingface_token_here

# ---------------------------------------------------------
# LLM — choose one:
#   (empty)  = retrieval-only, no LLM
#   openai   = use OpenAI API
# Ollama is NOT available on Colab (no local server)
# ---------------------------------------------------------
RAG_LLM_PROVIDER=

# OpenAI (only if RAG_LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------
# TESSERACT — Linux default (no Windows path needed)
# ---------------------------------------------------------
TESSERACT_CMD=tesseract

# ---------------------------------------------------------
# SCRAPER — not used in Colab (no browser)
# ---------------------------------------------------------
SCRAPE_INTERVAL_MINUTES=60
TARGET_PER_TYPE=10
MAX_EMPTY_PAGES=5
GEM_BASE_URL=https://bidplus.gem.gov.in

# ---------------------------------------------------------
# TENDER API
# ---------------------------------------------------------
TENDER_API_BASE_URL=
TENDER_API_KEY=
TENDER_API_TIMEOUT=30
TENDER_API_PAGE_SIZE=50
TENDER_API_RATE_DELAY=1.0
